{
    "name": "microcode/filament-database-backup",
    "description": "Filament plugin for database backup, restore, scheduling, and optional S3 storage.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "backup",
        "database",
        "mysqldump",
        "pg_dump",
        "s3"
    ],
    "authors": [
        {
            "name": "Microcode",
            "email": "info@microcode.vn.ua",
            "homepage": "https://github.com/vitkonovaluck"
        }
    ],
    "homepage": "https://github.com/vitkonovaluck/filament-database-backup",
    "support": {
        "issues": "https://github.com/vitkonovaluck/filament-database-backup/issues",
        "source": "https://github.com/vitkonovaluck/filament-database-backup"
    },
    "require": {
        "php": "^8.4",
        "filament/filament": "^4.0|^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "livewire/livewire": "^3.0|^4.0",
        "microcode/filament-integrations": "^1.1",
        "spatie/laravel-package-tools": "^1.16"
    },
    "suggest": {
        "league/flysystem-aws-s3-v3": "Required to upload database backups to S3"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Microcode\\FilamentDatabaseBackup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Microcode\\FilamentDatabaseBackup\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Microcode\\FilamentDatabaseBackup\\FilamentDatabaseBackupServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "pint": "vendor/bin/pint"
    }
}
